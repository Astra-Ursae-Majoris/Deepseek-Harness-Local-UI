{
  "name": "dsh-desktop",
  "version": "0.1.3",
  "description": "DeepSeek Harness 桌面版：DSH Web GUI 的桌面壳 + 服务管家",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:nsis": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8",
    "@types/node": "^24.0.0"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness 桌面版",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "DSH-Desktop-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "DSH-Desktop-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DeepSeek Harness 桌面版"
    }
  }
}
